# Copiar a .env.local para desarrollo. Los valores reales van en Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo servidor. Nunca exponer ni commitear.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Frase larga aleatoria; Vercel la envía al cron como "Bearer <CRON_SECRET>".
CRON_SECRET=cambiar-por-una-frase-larga
# Notificaciones push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
